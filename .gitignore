# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Virtualenv (kept on disk for local verification, never committed) ---
.venv/

# --- Secrets / key material ---
.env
.env.*
!deploy/.env.production.example
# Console build-EDITION profiles are NON-secret public compile flags
# (VITE_MCPIP_EDITION only) — committed so staging/production builds are
# reproducible from a fresh clone / CI. NEVER put a secret in these files.
!dashboard/.env.production
!dashboard/.env.staging
!dashboard/.env.internal
*.pem
*.key

# --- Runtime WORM audit log (log + regenerable epoch-head anchor) ---
mcpip_worm.jsonl
mcpip_worm.jsonl.anchor
*.anchor

# --- OS cruft ---
.DS_Store

# --- Dashboard (Vite/React) build + deps ---
dashboard/node_modules/
dashboard/dist/
*.tsbuildinfo

# Rust build artifacts (PyO3 fast-path crate)
rust/**/target/
target/

# --- Tauri desktop shell: Rust build + codegen + generated icon set ---
# (source `app-icon.png` IS committed; the platform icon set is generated by
#  `npm run desktop:icons` / CI and never committed)
dashboard/src-tauri/target/
dashboard/src-tauri/gen/
dashboard/src-tauri/icons/*.png
dashboard/src-tauri/icons/*.ico
dashboard/src-tauri/icons/*.icns

# Offline signing keys (never commit private key material)
.keys/

# --- Release build outputs (artifacts are signed + shipped, never committed) ---
dist/
build/
*.egg-info/
release/sbom/*.tmp

# --- SDK build/dep/cache dirs (regenerable; never committed) -------------------
# `.mypy_cache/` is already covered above; these keep the sdk/ trees clean too.
sdk/**/node_modules/
sdk/**/dist/
sdk/**/build/

# Generated SLSA/in-toto provenance predicate — produced at ceremony time and
# attested with the owner's OFFLINE cosign key, never committed (like dist/).
release/provenance.intoto.json
release/*.provenance.intoto.json

# PUBLIC release/license verification keys ARE committed (private keys stay in
# .keys/ — the *.pem/*.key excludes above still cover all private material).
!release/keys/*.pub.pem

# --- Local dev Redis artifacts (a redis-server started in the repo dir would
# --- otherwise snapshot its database state here — never committed) ------------
dump.rdb
appendonlydir/
mcpip-workspace-plan.json
