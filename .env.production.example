# =============================================================================
# ◐ MCPIP — production environment schema  (template — copy, do not commit real values)
# =============================================================================
# This file contains NO SECRETS. It holds only non-sensitive configuration and
# FILE PATHS. Secret MATERIAL (private keys, the license) is never written here —
# it is injected at deploy time from your secret manager into the referenced paths
# by scripts/deploy_hero.sh (which writes them 0600 to a tmpfs, never the image).
#
# `.env` and `.env.*` are gitignored; `.env.production.example` (this template,
# values blanked/placeholdered) is the ONLY variant that is committed.
# -----------------------------------------------------------------------------

# --- Posture: production is fail-closed. Never set true in the Hero system. ----
MCPIP_SANDBOX_MODE=false

# --- Edge -------------------------------------------------------------------
MCPIP_API_HOST=0.0.0.0
MCPIP_API_PORT=8080
MCPIP_MAX_IN_FLIGHT=64
MCPIP_REQUEST_TIMEOUT_S=15.0

# --- State: Redis. Linearizable + noeviction (replay guard) + AOF appendfsync
#     always (write-before-execute durability). Credentials, if any, come from
#     the secret store as a full URL — never inline a password in a committed file.
MCPIP_REDIS_URL=redis://mcpip-redis.internal:6379/0
MCPIP_REDIS_MAX_CONNECTIONS=64

# --- Identity sovereignty: iss/aud MUST match the minted principal tokens. -----
MCPIP_JWT_ISSUER=prod-idp.hero
MCPIP_JWT_AUDIENCE=mcpip-gateway
# PUBLIC IdP key (SubjectPublicKeyInfo PEM). Materialized 0600 at deploy time.
MCPIP_JWT_PUBLIC_KEY_PATH=/run/secrets/mcpip/idp_signing_ed25519.pub.pem

# --- WORM audit ledger ------------------------------------------------------
MCPIP_WORM_PATH=/var/lib/mcpip/mcpip_worm.jsonl
MCPIP_WORM_ANCHOR_PATH=/var/lib/mcpip/mcpip_worm.jsonl.anchor
# PRIVATE Ed25519 epoch-signing key. Materialized 0600 to tmpfs at deploy time.
MCPIP_WORM_SIGNING_KEY_PATH=/run/secrets/mcpip/worm_signing_ed25519.key

# --- Out-of-band step-up OTP delivery (REQUIRED for any PIN_REQUIRED skill) --
# In production the payload-bound one-time code is PUSHED to your authenticator/
# approver sink over an SSRF-guarded, HMAC-SHA256-signed HTTPS webhook (no OTP is
# ever stored in Redis). BOTH the URL and the signing-secret path are required to
# activate delivery; with either unset, every PIN_REQUIRED staging fails closed
# (OTP_DELIVERY_FAILED) — an AUTO-only deployment can leave both blank. Setting
# exactly one is a fail-closed BOOT error. The URL must be https and must not
# resolve into a private/loopback/link-local range.
MCPIP_AUTHN_WEBHOOK_URL=
# Raw HMAC-SHA256 signing secret (>=32 bytes). Materialized 0600 at deploy time.
MCPIP_AUTHN_WEBHOOK_SECRET_PATH=
# Bounded connect+read timeout for one push (clamped to [0.5s, 30s]).
MCPIP_AUTHN_WEBHOOK_TIMEOUT_S=5.0

# --- Verified-boot integrity manifest (REQUIRED in production) --------------
MCPIP_INTEGRITY_MANIFEST_PATH=/etc/mcpip/integrity_manifest.json
MCPIP_INTEGRITY_PUBLIC_KEY_PATH=/etc/mcpip/release_root_ed25519.pub.pem
# The dev bypass MUST be false in production (boot refuses otherwise).
MCPIP_INTEGRITY_DEV_BYPASS=false

# --- License (REQUIRED in production; Ed25519-signed) -----------------------
MCPIP_LICENSE_PATH=/etc/mcpip/license.json
MCPIP_LICENSE_PUBLIC_KEY_PATH=/etc/mcpip/license_root_ed25519.pub.pem

# -----------------------------------------------------------------------------
# Secret material referenced above (private keys, license) is delivered by the
# deploy pipeline from the secret store — see scripts/deploy_hero.sh. If any
# required path is missing or MCPIP_SANDBOX_MODE=false without them, the gateway
# REFUSES to boot (fail-closed). That refusal is the intended safety net.
# -----------------------------------------------------------------------------
