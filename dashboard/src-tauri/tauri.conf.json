{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPIP",
  "version": "3.0.0",
  "identifier": "com.mcpip.operator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "\u25d0 MCPIP",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https: wss: http://localhost:8080 ws://localhost:8080; frame-ancestors 'none'; object-src 'none'; base-uri 'self'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "MCPIP zero-trust operator console",
    "longDescription": "Native desktop shell for the \u25d0 MCPIP operator console \u2014 WORM audit ledger, IAM principal directory, execution-policy knowledge graph, and live decision stream. Talks to the MCPIP gateway over HTTPS/WSS with the same token/mTLS standards as the web portal.",
    "copyright": "\u00a9 MCPIP",
    "publisher": "MCPIP",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
