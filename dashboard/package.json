{
  "name": "mcpip-operator-dashboard",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "MCPIP — The Authorization Layer for Autonomous AI. Operator console (porcelain/ink).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:staging": "tsc --noEmit && vite build --mode staging",
    "build:internal": "tsc --noEmit && vite build --mode internal",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:icons": "tauri icon src-tauri/app-icon.png",
    "predesktop:dev": "npm run desktop:icons",
    "desktop:dev": "tauri dev",
    "predesktop:build": "npm run desktop:icons",
    "desktop:build": "tauri build",
    "predesktop:build:mac": "npm run desktop:icons",
    "desktop:build:mac": "tauri build --target universal-apple-darwin",
    "predesktop:build:win": "npm run desktop:icons",
    "desktop:build:win": "tauri build",
    "predesktop:build:linux": "npm run desktop:icons",
    "desktop:build:linux": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "framer-motion": "12.43.0",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "8.5.19",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
