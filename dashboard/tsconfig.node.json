{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // vite.config.ts imports node:fs — it needs the node type library explicitly.
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
